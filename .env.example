# Supabase — copy to .env.local and fill in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the Vercel Cron sweep at /api/cron/expire-attempts.
# Set to a long random string; leave blank to disable the route.
CRON_SECRET=
